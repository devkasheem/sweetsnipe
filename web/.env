# ========== ENVIRONMENT ==========
ENV=production
DEBUG=false

# ========== SECURITY: Secrets ==========
# CRITICAL: Replace the values below with your actual production secrets
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate ENCRYPTION_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=REPLACE_WITH_YOUR_PRODUCTION_SECRET_KEY
ENCRYPTION_KEY=REPLACE_WITH_YOUR_PRODUCTION_FERNET_KEY

# ========== DATABASE ==========
# Railway will auto-inject DATABASE_URL when you add the PostgreSQL plugin.
# Leave the default SQLite only for local development.
DATABASE_URL=sqlite:///./sweetsnipe.db

# ========== TREASURY ==========
# Replace with your actual treasury wallet credentials
TREASURY_ADDRESS=0xYourTreasuryWalletAddress
# TREASURY_PRIVATE_KEY is optional and only needed if you want the backend
# to perform on-chain operations from the treasury wallet.
TREASURY_PRIVATE_KEY=
TREASURY_NETWORK=ETH
PRICE_PER_WALLET_USDT=1.0

# ========== CORS ==========
# Railway provides your app URL automatically. Set this to your Railway domain.
# Example: https://sweetsnipe-production.up.railway.app
ALLOWED_ORIGINS=https://your-app.up.railway.app

# ========== RATE LIMITING ==========
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_JOB_CREATE=10/minute
RATE_LIMIT_PAYMENT=5/minute

# ========== OPTIONAL: CACHING ==========
# REDIS_URL=redis://localhost:6379/0

# ========== OPTIONAL: MONITORING ==========
# SENTRY_DSN=your-sentry-dsn
# LOG_LEVEL=INFO
